#!/usr/bin/env bash
# Stands in for secret-tool, backed by one file, so a test never touches the
# real keyring. FAKE_KEYRING_DOWN=1 is a missing Secret Service;
# FAKE_KEYRING_STUCK=1 is an entry that will not clear.
[ -z "${FAKE_KEYRING_DOWN:-}" ] || { echo "Cannot autolaunch D-Bus" >&2; exit 1; }
db="$FAKE_DIR/keyring"
printf '%s\n' "$*" >> "$db.log"
case "$1" in
  store)  cat > "$db" ;;
  lookup) [ -f "$db" ] && cat "$db" ;;
  clear)  [ -n "${FAKE_KEYRING_STUCK:-}" ] || rm -f "$db" ;;
esac
