#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
for f in "$root"/tests/fixtures/*.json; do
  python3 -m json.tool "$f" >/dev/null
done
for f in "$root"/tests/fakes/*; do
  bash -n "$f"
done

# Dates in the fixtures are UTC; pin the zone so formatted times match.
TZ=UTC node --test "$root"/tests/*.test.js

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

printf 'All portable plugin checks passed.\n'
